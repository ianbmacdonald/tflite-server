# Selective TFLite builtin-op registration for tflite-server.
#
# LiteRT's CompiledModel builds its interpreter with a hard-coded
# tflite::ops::builtin::BuiltinOpResolverWithoutDefaultDelegates (or BuiltinRefOpResolver
# in reference-kernel mode), whose constructors (tflite/core/kernels/register.cc and
# tflite/kernels/register_ref.cc) call AddBuiltin for every builtin op. Those calls are what
# pull every kernel object into a static link. This module generates copies of the two files
# with every AddBuiltin/AddCustom call removed except the listed ops, and compiles them into
# the executable: they define the same symbols, so the linker never pulls the archive members
# that would register (and link) the rest. Reference-kernel mode gets the same op set.

function(tflite_server_selected_ops ops_file litert_src out_var)
  file(STRINGS "${ops_file}" _lines)
  set(_ops "")
  foreach(l IN LISTS _lines)
    string(REGEX REPLACE "#.*$" "" l "${l}")
    string(STRIP "${l}" l)
    if(l)
      list(APPEND _ops "${l}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _ops)
  if(NOT _ops)
    message(FATAL_ERROR "TFLITE_SERVER_OPS: ${ops_file} lists no operators")
  endif()

  set(_gen "${CMAKE_CURRENT_BINARY_DIR}/selected_ops")
  file(MAKE_DIRECTORY "${_gen}")
  set(_outs "")
  foreach(src "tflite/core/kernels/register.cc" "tflite/kernels/register_ref.cc")
    set(_in "${litert_src}/${src}")
    if(NOT EXISTS "${_in}")
      message(FATAL_ERROR "TFLITE_SERVER_OPS: ${_in} not found")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_in}" "${ops_file}")
    file(READ "${_in}" _txt)
    string(REGEX MATCHALL "AddBuiltin\\(BuiltinOperator_[A-Z0-9_]+,[^;]*;" _calls "${_txt}")
    set(_kept "")
    foreach(c IN LISTS _calls)
      string(REGEX MATCH "BuiltinOperator_([A-Z0-9_]+)" _m "${c}")
      if(CMAKE_MATCH_1 IN_LIST _ops)
        list(APPEND _kept "${CMAKE_MATCH_1}")
      else()
        string(REPLACE "${c}" "" _txt "${_txt}")
      endif()
    endforeach()
    string(REGEX MATCHALL "AddCustom\\(\"[^\"]+\",[^;]*;" _customs "${_txt}")
    foreach(c IN LISTS _customs)
      string(REGEX MATCH "AddCustom\\(\"([^\"]+)\"" _m "${c}")
      if(NOT "CUSTOM:${CMAKE_MATCH_1}" IN_LIST _ops)
        string(REPLACE "${c}" "" _txt "${_txt}")
      endif()
    endforeach()
    if(src MATCHES "register\\.cc$")
      foreach(op IN LISTS _ops)
        if(NOT op MATCHES "^CUSTOM:" AND NOT op IN_LIST _kept)
          message(FATAL_ERROR "TFLITE_SERVER_OPS: ${op} is not a builtin op registered by ${src}")
        endif()
      endforeach()
      list(LENGTH _kept _n)
      list(LENGTH _calls _all)
      message(STATUS "tflite-server: registering ${_n} of ${_all} builtin ops from ${ops_file}")
    endif()
    get_filename_component(_name "${src}" NAME_WE)
    set(_out "${_gen}/selected_${_name}.cc")
    file(CONFIGURE OUTPUT "${_out}" CONTENT "// Generated by cmake/SelectedOps.cmake from ${src} and ${ops_file}.\n${_txt}" @ONLY)
    list(APPEND _outs "${_out}")
  endforeach()
  set(${out_var} "${_outs}" PARENT_SCOPE)
endfunction()
